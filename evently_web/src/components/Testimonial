import { useEffect, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { motion } from 'framer-motion';
import api from '../api/axios';
import './Testimonials.css';

export default function Testimonials() {
  const navigate = useNavigate();
  const [reviews, setReviews] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    api.get('/api/reviews/showcase')
      .then((res) => setReviews(res.data || []))
      .catch(() => setReviews([]))
      .finally(() => setLoading(false));
  }, []);

  if (loading || reviews.length === 0) return null;

  return (
    <section className="testimonials" id="testimonials">
      <div className="testimonials__inner">
        <header className="testimonials__head">
          <div>
            <p className="testimonials__kicker">What people say</p>
            <h2 className="testimonials__heading">Reviews from real events.</h2>
          </div>
          <p className="testimonials__lead">
            Every review is tied to a completed booking. No anonymous ratings,
            no paid placements.
          </p>
        </header>

        <div className="testimonials__grid">
          {reviews.map((r) => (
            <motion.figure
              key={r.id}
              className="testimonial testimonial--clickable"
              onClick={() => navigate(`/providers/${r.provider.id}`)}
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true, amount: 0.2 }}
            >
              <div className="testimonial__stars">
                {'★'.repeat(r.rating)}
                <span className="testimonial__stars--dim">
                  {'★'.repeat(5 - r.rating)}
                </span>
              </div>
              <blockquote className="testimonial__quote">
                "{r.comment}"
              </blockquote>
              <figcaption className="testimonial__by">
                <span className="testimonial__name">{r.client}</span>
                <span className="testimonial__role">
                  {r.provider.category} · {r.provider.business_name}
                </span>
              </figcaption>
            </motion.figure>
          ))}
        </div>
      </div>
    </section>
  );
}